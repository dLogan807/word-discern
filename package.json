{
  "name": "word-discern",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-licenses && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "npm run generate-licenses && tsc --noEmit",
    "generate-licenses": "license-report --only=prod --output=json > ./src/generated/licenses.json",
    "lint": "npm run generate-licenses && npm run oxlint && npm run stylelint",
    "oxlint": "oxlint .",
    "stylelint": "stylelint \"**/*.css\" --cache",
    "format:test": "oxfmt --check \"**/*.{ts,tsx,css}\"",
    "format:write": "oxfmt --write \"**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@mantine/core": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@tabler/icons-react": "^3.46.0",
    "@types/node": "^26.4.1",
    "jsonc-parser": "^3.3.1",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stylelint": "^17.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "baseline-browser-mapping": "^2.11.21",
    "license-report": "^6.8.5",
    "oxfmt": "^0.66.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^22.22.2"
  }
}
